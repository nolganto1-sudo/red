-- Mobile Draggable Fix
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
local function updateInput(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then updateInput(input) end
end)

-- ================= GUI LOGIC & SCANNING =================
local plantsRoot = workspace:FindFirstChild("Plants")

local function updateSelectedCount()
    local count = 0
    for _, isSelected in pairs(targetPlants) do
        if isSelected then count = count + 1 end
    end
    infoLabel.Text = count > 0 and ("Targeting " .. count .. " items") or "Pilih item untuk di farm:"
end

local function createPlantButton(name)
    if plantButtons[name] and plantButtons[name].Parent then return end
    if targetPlants[name] == nil then targetPlants[name] = false end

    local btn = Instance.new("TextButton", scrollFrame)
    btn.Size = UDim2.new(1, 0, 0, 45)
    btn.Text = name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.BackgroundColor3 = targetPlants[name] and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(50, 50, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    btn.MouseButton1Click:Connect(function()
        targetPlants[name] = not targetPlants[name]
        btn.BackgroundColor3 = targetPlants[name] and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(50, 50, 60)
        updateSelectedCount()
    end)
    plantButtons[name] = btn
end

local function scanUniquePlants()
    if scanning then return end
    scanning = true

    if plantsRoot then
        for _, child in ipairs(plantsRoot:GetDescendants()) do
            if child:IsA("Model") then
                local hasActivePrompt = false
                for _, prompt in ipairs(child:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local collectable = prompt.Parent:FindFirstChild("Collectable")
                        if not collectable or collectable.Value == true then
                            hasActivePrompt = true
                            break
                        end
                    end
                end
                if hasActivePrompt then 
                    knownPlants[child.Name] = true 
                end
            end
        end
    end

    for name,_ in pairs(knownPlants) do 
        createPlantButton(name) 
    end

    updateSelectedCount()
    scanning = false
end

refreshBtn.MouseButton1Click:Connect(scanUniquePlants)
scanUniquePlants()

-- ================= ORIGINAL LOGIC =================
local noclipConn = nil
local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    if part.Name == "HumanoidRootPart" or part.Name == "LowerTorso" or part.Name == "UpperTorso" or part:IsDescendantOf(char) then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

local function disableNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = true end)
            end
        end
    end
    if hrp then pcall(function() hrp.Anchored = false end) end
end

local currentGyro = nil
local currentBV = nil
local function applyStabilizer(duration)
    duration = duration or 1.2
    if not hrp then return end
    if currentGyro and currentGyro.Parent then currentGyro:Destroy() end
    if currentBV and currentBV.Parent then currentBV:Destroy() end

    currentGyro = Instance.new("BodyGyro")
    currentGyro.P = 4000
    currentGyro.D = 100
    currentGyro.MaxTorque = Vector3.new(4e5,4e5,4e5)
    currentGyro.CFrame = hrp.CFrame
    currentGyro.Parent = hrp

    currentBV = Instance.new("BodyVelocity")
    currentBV.Velocity = Vector3.new(0,0,0)
    currentBV.MaxForce = Vector3.new(1e6,1e6,1e6)
    currentBV.Parent = hrp

    Debris:AddItem(currentGyro, duration)
    Debris:AddItem(currentBV, duration)
end

local function getPlantPosition(plant)
    if not plant then return nil end
    if plant.PrimaryPart then return plant.PrimaryPart.Position end
    for _, p in ipairs(plant:GetDescendants()) do
        if p:IsA("BasePart") then return p.Position end
    end
    return nil
end

local function findAllPlants()
    local result = {}
    if not plantsRoot then return result end
    
    local hasTarget = false
    for _, isSelected in pairs(targetPlants) do
        if isSelected then hasTarget = true break end
    end
    if not hasTarget then return result end

    for _, obj in ipairs(plantsRoot:GetDescendants()) do
        if obj:IsA("Model") and targetPlants[obj.Name] then
            local hasActivePrompt = false
            for _, prompt in ipairs(obj:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    local collectable = prompt.Parent:FindFirstChild("Collectable")
                    if not collectable or collectable.Value == true then
                        hasActivePrompt = true break
                    end
                end
            end
            if hasActivePrompt then table.insert(result, obj) end
        end
    end
    return result
end

local function triggerPrompt(prompt)
    if not prompt then return end
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0.05)
            prompt:InputHoldEnd()
        end)
    end
end

local function moveTo(pos)
    if not pos or not hrp then return false end
    hrp.Anchored = false 
    applyStabilizer(1.5)

    local distance = (hrp.Position - pos).Magnitude
    local time = math.clamp(distance / tweenSpeed, 0.04, 2.2)
    local success = pcall(function()
        local targetCFrame = CFrame.new(pos + Vector3.new(0,3,0))
        local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end)
    if success then return true end

    if humanoid and humanoid.Parent then
        local ok, err = pcall(function()
            humanoid:MoveTo(pos + Vector3.new(0,3,0))
            humanoid.MoveToFinished:Wait()
        end)
        return ok
    end
    return false
end

local function markCollected(model)
    recentCollected[model] = tick()
end
local function wasRecentlyCollected(model)
    if not model then return false end
    local t = recentCollected[model]
    if not t then return false end
    return (tick() - t) < recentCooldown
end

-- ================= AREA COLLECT DENGAN SMART VERIFICATION =================
local function collectFromPlant(plant, allPlants)
    if not plant or not plant:IsA("Model") then return false end
    if wasRecentlyCollected(plant) then return false end

    local pos = getPlantPosition(plant)
    if not pos then return false end

    local moved = moveTo(pos)
    if not moved then return false end

    if hrp then hrp.Anchored = true end -- Kunci di air / darat

    -- Kumpulkan semua prompt di area sekitar (radius 25 studs)
    local activePrompts = {}
    for _, p in ipairs(allPlants) do
        if not wasRecentlyCollected(p) then
            local pPos = getPlantPosition(p)
            if pPos and (hrp.Position - pPos).Magnitude <= clusterRadius then
                for _, desc in ipairs(p:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") and desc.Enabled then
                        local collectable = desc.Parent:FindFirstChild("Collectable")
                        if not collectable or collectable.Value == true then
                            table.insert(activePrompts, {prompt = desc, plantModel = p})
                        end
                    end
                end
            end
        end
    end

    if #activePrompts > 0 then
        -- Tandai duluan agar tidak diganggu oleh iterasi lain
        for _, item in ipairs(activePrompts) do
            markCollected(item.plantModel)
        end

        -- 1. Picu (Trigger) semua prompt secara bersamaan
        for _, item in ipairs(activePrompts) do
            task.spawn(function()
                local tries = 0
                while tries < maxRetryPerPrompt do
                    tries = tries + 1
                    task.spawn(function() triggerPrompt(item.prompt) end)
                    task.wait((item.prompt.HoldDuration or 0.05) + retryBuffer)
                    
                    local stillActive = false
                    if item.prompt and item.prompt.Parent and item.prompt:IsA("ProximityPrompt") then
                        if item.prompt.Enabled then
                            local col = item.prompt.Parent:FindFirstChild("Collectable")
                            if not col or col.Value == true then
                                stillActive = true
                            end
                        end
                    end
                    
                    if not stillActive then break end
                    task.wait(0.1)
                end
            end)
        end

        -- 2. SMART VERIFICATION LOOP (Mencegah Bolak-Balik)
        -- Karakter akan diam menunggu sampai semua prompt BENAR-BENAR HILANG / masuk inventory
        local timeout = 5.0 -- Batas maksimal nunggu (failsafe)
        local timeWaited = 0

        while timeWaited < timeout do
            local allCleared = true
            
            for _, item in ipairs(activePrompts) do
                -- Cek apakah prompt masih aktif di dunia (belum ke-collect server)
                if item.prompt and item.prompt.Parent and item.prompt.Enabled then
                    local col = item.prompt.Parent:FindFirstChild("Collectable")
                    if not col or col.Value == true then
                        allCleared = false
                        break
                    end
                end
            end
            
            -- Jika semua item sudah bersih (sukses collect), langsung stop menunggu
            if allCleared then break end
            
            task.wait(0.2)
            timeWaited = timeWaited + 0.2
        end

        if hrp then hrp.Anchored = false end
        return true
    end
    
    if hrp then hrp.Anchored = false end
    return false
end

-- ================= MAIN LOOP & TOGGLE =================
task.spawn(function()
    while true do
        local hasTarget = false
        for _, isSelected in pairs(targetPlants) do
            if isSelected then hasTarget = true break end
        end

        if autoCollect and hasTarget and hrp and humanoid and humanoid.Health > 0 then
            if noclipEnabled then enableNoclip() else disableNoclip() end

            local plants = findAllPlants()
            if #plants > 0 then
                table.sort(plants, function(a,b)
                    local pa, pb = getPlantPosition(a), getPlantPosition(b)
                    if not pa then return false end
                    if not pb then return true end
                    return (hrp.Position - pa).Magnitude < (hrp.Position - pb).Magnitude
                end)
                
                for _, plant in ipairs(plants) do
                    if not autoCollect then break end
                    if not wasRecentlyCollected(plant) then
                        collectFromPlant(plant, plants) 
                    end
                end
            end
        else
            disableNoclip()
        end
        task.wait(scanInterval)
        scanUniquePlants()
    end
end)

