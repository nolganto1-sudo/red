-- Dragging Logic
local dragging, dragStart, startPos
titleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + (input.Position - dragStart).X, startPos.Y.Scale, startPos.Y.Offset + (input.Position - dragStart).Y)
    end
end)

-- ==================== CORE UTILITIES ====================
player.CharacterAdded:Connect(function(c)
    char = c
    hrp = char:WaitForChild("HumanoidRootPart")
end)

local function isAlive()
    if not char or not char.Parent or not hrp or not hrp.Parent then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    return hum and hum.Health > 0
end

local function clearPhysicsLock()
    if isAlive() then
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") and v.Name == "AutoFreeze" then v:Destroy() end
        end
    end
end

local function applyPhysicsLock()
    clearPhysicsLock()
    if isAlive() then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "AutoFreeze"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
end

-- ==================== GATE JOINER LOGIC ====================
local function safeTeleportGate(targetCFrame)
    if not isAlive() then return end
    isJoiningGate = true -- Pause Miner
    
    local tweenTime = 2.8
    local liftHeight = 60
    
    -- Naik
    local upTween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = hrp.CFrame + Vector3.new(0, liftHeight, 0)})
    upTween:Play()
    upTween.Completed:Wait()
    
    if not isAlive() then isJoiningGate = false return end
    
    -- Turun
    local downTween = TweenService:Create(hrp, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCFrame + Vector3.new(0, 5, 0)})
    downTween:Play()
    downTween.Completed:Wait()

    if not isAlive() then isJoiningGate = false return end
    
    applyPhysicsLock()
    task.wait(0.3)
    
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Seated)
            task.wait(0.2)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
    isJoiningGate = false
end

local function autoJoinLoop()
    while task.wait(5) do
        if config.Toggles.AutoJoin and isAlive() then
            local pcallSuccess, _ = pcall(function()
                local gates = workspace:FindFirstChild("Gates")
                if gates then
                    local blueGate = gates:FindFirstChild("BlueGate")
                    if blueGate and blueGate:FindFirstChild("Gate") then
                        local gatePart = blueGate.Gate
                        local join = gatePart:FindFirstChild("JoinParty")
                        local ready = gatePart:FindFirstChild("ReadyTag")

                        safeTeleportGate(gatePart.CFrame)
                        task.wait(0.8)

                        if join then join:FireServer() end
                        task.wait(0.8)
                        if ready then ready:FireServer() end
                    end
                end
            end)
            if not pcallSuccess then clearPhysicsLock() end
        end
    end
end

-- ==================== AUTO MINER LOGIC ====================
-- (Fungsi baca nama & HP disingkat untuk menghemat ruang)
local function getOreData(item)
    local dn = item:FindFirstChild("DataName") or (item.Parent and item.Parent:FindFirstChild("DataName"))
    local name = dn and dn.Value ~= "" and tostring(dn.Value) or item.Name
    local hpNode = item:FindFirstChild("HP") or item:FindFirstChild("Health") or (item.Parent and (item.Parent:FindFirstChild("HP") or item.Parent:FindFirstChild("Health")))
    local hp = (hpNode and hpNode:IsA("Humanoid")) and hpNode.Health or (hpNode and hpNode:IsA("ValueBase")) and tonumber(hpNode.Value) or nil
    return name, hp, hpNode
end

local function updateOreUI(oreName)
    if knownUIOres[oreName] then return end
    knownUIOres[oreName] = true
    if config.Ores[oreName] == nil then config.Ores[oreName] = false end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Text = oreName .. (config.Ores[oreName] and " [ON]" or " [OFF]")
    btn.BackgroundColor3 = config.Ores[oreName] and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(100, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = scrollFrame

    btn.MouseButton1Click:Connect(function()
        config.Ores[oreName] = not config.Ores[oreName]
        btn.Text = oreName .. (config.Ores[oreName] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = config.Ores[oreName] and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(100, 40, 40)
        saveConfig()
    end)
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y)
end

-- Background scanner untuk UI Ores
task.spawn(function()
    while task.wait(2) do
        local folder = workspace:FindFirstChild("Ores") or workspace
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") or item:IsA("BasePart") then
                local name, hp, _ = getOreData(item)
                if hp ~= nil and not knownUIOres[name] then
                    updateOreUI(name)
                    saveConfig()
                end
            end
        end
    end
end)

local function equipHitTool()
    if not isAlive() then return nil end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool and player:FindFirstChild("Backpack") then tool = player.Backpack:FindFirstChildWhichIsA("Tool") end
    if tool and tool.Parent ~= char then char:FindFirstChild("Humanoid"):EquipTool(tool) end
    return tool
end

local function autoMineLoop()
    while task.wait(0.2) do
        if config.Toggles.AutoMine and not isJoiningGate then
            pcall(function()
                if not isAlive() then return end
                
                -- Cari Ore terdekat
                local best, bestDist = nil, math.huge
                local folder = workspace:FindFirstChild("Ores") or workspace
                for _, item in ipairs(folder:GetChildren()) do
                    if item:IsA("Model") or item:IsA("BasePart") then
                        local name, hp, _ = getOreData(item)
                        if config.Ores[name] and hp and hp > 0 then
                            local main = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item
                            local d = (main.Position - hrp.Position).Magnitude
                            if d < bestDist then best, bestDist = item, d end
                        end
                    end
                end

                if not best then clearPhysicsLock() return end

                local main = best:IsA("Model") and (best.PrimaryPart or best:FindFirstChildWhichIsA("BasePart")) or best
                local targetPos = main.Position + Vector3.new(0, 3, 2)
                
                applyPhysicsLock()
                local tTime = math.clamp((hrp.Position - targetPos).Magnitude / 150, 0.1, 1)
                local tween = TweenService:Create(hrp, TweenInfo.new(tTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                tween:Play()
                tween.Completed:Wait()

                local tool = equipHitTool()
                local _, currentHP, _ = getOreData(best)
                local lastHP = currentHP or 0
                local lastTime = tick()

                while config.Toggles.AutoMine and not isJoiningGate and currentHP and currentHP > 0 and best.Parent and isAlive() do
                    if tool then
                        local re = tool:FindFirstChildWhichIsA("RemoteEvent", true)
                        local rf = tool:FindFirstChildWhichIsA("RemoteFunction", true)
                        local sw = tool:FindFirstChild("SwordScript")
                        if re then pcall(function() re:FireServer() end)
                        elseif rf then pcall(function() rf:InvokeServer() end)
                        elseif sw and sw:FindFirstChild("Activate") then pcall(function() sw.Activate:FireServer() end)
                        elseif tool.Activate then pcall(function() tool:Activate() end) end
                    end
                    task.wait(0.1)

                    _, currentHP, _ = getOreData(best)
                    if currentHP ~= lastHP then lastHP = currentHP; lastTime = tick()
                    elseif tick() - lastTime > 3 then
                        hrp.CFrame = hrp.CFrame * CFrame.new(math.random(-2,2), 0, math.random(-2,2))
                        lastTime = tick()
                    end
                end
                clearPhysicsLock()
            end)
        end
    end
end

