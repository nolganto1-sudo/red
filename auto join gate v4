    btnMine.TextColor3 = Color3.fromRGB(255, 255, 255)

    btnJoin.Text = config.Toggles.AutoJoin and "🚪 STOP BLUE GATE" or "🚪 START BLUE GATE"
    btnJoin.BackgroundColor3 = config.Toggles.AutoJoin and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(50, 50, 50)
    btnJoin.TextColor3 = Color3.fromRGB(255, 255, 255)

    btnSkill.Text = "⚡ Auto Skill 'V' [" .. (config.Toggles.AutoSkill and "ON" or "OFF") .. "]"
    btnSkill.BackgroundColor3 = config.Toggles.AutoSkill and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(100, 40, 40)
    btnSkill.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    for ore, val in pairs(config.Ores) do updateOreUI(ore) end
end

btnMine.MouseButton1Click:Connect(function() config.Toggles.AutoMine = not config.Toggles.AutoMine; updateUIStates(); saveConfig(); if not config.Toggles.AutoMine then clearPhysicsLock() end end)
btnJoin.MouseButton1Click:Connect(function() config.Toggles.AutoJoin = not config.Toggles.AutoJoin; updateUIStates(); saveConfig(); if not config.Toggles.AutoJoin then clearPhysicsLock() end end)
btnSkill.MouseButton1Click:Connect(function() config.Toggles.AutoSkill = not config.Toggles.AutoSkill; updateUIStates(); saveConfig() end)

-- Initialize
updateUIStates()
task.spawn(autoJoinLoop)
task.spawn(autoMineLoop)
