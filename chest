    else
        toggleBtn.Text = "Auto: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(170,0,0)
        infoLabel.Text = "Auto OFF"
        disableNoclip()
    end
end)

scanUniqueChests()
