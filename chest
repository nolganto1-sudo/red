-- helper: safe destroy GUI objects
local function safeDestroyGui(obj)
    if obj and obj.Destroy and type(obj.Destroy) == "function" then
        pcall(function() obj:Destroy() end)
    end
end

-- create button
local function createChestButton(name)
    if chestButtons[name] and chestButtons[name].Parent then return end
    local btn = Instance.new("TextButton", scrollFrame)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Text = name
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    btn.TextColor3 = Color3.fromRGB(255,255,255)

    btn.MouseButton1Click:Connect(function()
        targetChest = name
        for k, v in pairs(chestButtons) do
            if v and v:IsA("TextButton") then
                v.BackgroundColor3 = (k == name) and Color3.fromRGB(0,150,0) or Color3.fromRGB(120,0,0)
            end
        end
        infoLabel.Text = "Target: "..name
    end)

    chestButtons[name] = btn
end

-- scan chests
local function scanUniqueChests()
    if scanning then return end
    scanning = true

    for name, btn in pairs(chestButtons) do
        if not btn or not btn.Parent then
            chestButtons[name] = nil
        end
    end

    local foundNames = {}
    if not chestsRoot then
        chestsRoot = workspace:FindFirstChild("Chests")
    end

    if chestsRoot then
        for _, child in ipairs(chestsRoot:GetDescendants()) do
            if child:IsA("Model") then
                local hasActivePrompt = false
                for _, prompt in ipairs(child:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local collectable = prompt.Parent:FindFirstChild("Collectable")
                        if not collectable or collectable.Value == true then
                            hasActivePrompt = true
                            break
                        end
                    end
                end
                if hasActivePrompt then
                    foundNames[child.Name] = true
                end
            end
        end
    end

    for name,_ in pairs(foundNames) do
        createChestButton(name)
    end

    for name, btn in pairs(chestButtons) do
        if not foundNames[name] then
            safeDestroyGui(btn)
            chestButtons[name] = nil
            if targetChest == name then
                targetChest = nil
                infoLabel.Text = "Target removed"
            end
        end
    end

    local count = 0
    for _,v in pairs(chestButtons) do if v and v.Parent then count = count + 1 end end
    if count == 0 then
        infoLabel.Text = "Tidak ada chest yang valid."
    else
        infoLabel.Text = "Found: "..tostring(count)
    end

    scanning = false
end

refreshBtn.MouseButton1Click:Connect(scanUniqueChests)
scanUniqueChests()

-- Noclip helper
local noclipConn = nil
local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    if part.Name == "HumanoidRootPart" or part.Name == "LowerTorso" or part.Name == "UpperTorso" or part:IsDescendantOf(char) then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end
local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = true end)
            end
        end
    end
end

-- Stabilizer
local currentGyro = nil
local currentBV = nil
local function applyStabilizer(duration)
    duration = duration or 1.2
    if not hrp then return end
    if currentGyro and currentGyro.Parent then currentGyro:Destroy() end
    if currentBV and currentBV.Parent then currentBV:Destroy() end

    currentGyro = Instance.new("BodyGyro")
    currentGyro.P = 4000
    currentGyro.D = 100
    currentGyro.MaxTorque = Vector3.new(4e5,4e5,4e5)
    currentGyro.CFrame = hrp.CFrame
    currentGyro.Parent = hrp

    currentBV = Instance.new("BodyVelocity")
    currentBV.Velocity = Vector3.new(0,0,0)
    currentBV.MaxForce = Vector3.new(1e6,1e6,1e6)
    currentBV.Parent = hrp

    Debris:AddItem(currentGyro, duration)
    Debris:AddItem(currentBV, duration)
end

local function getChestPosition(chest)
    if not chest then return nil end
    if chest.PrimaryPart then return chest.PrimaryPart.Position end
    for _, p in ipairs(chest:GetDescendants()) do
        if p:IsA("BasePart") then return p.Position end
    end
    return nil
end

local function findAllChests()
    local result = {}
    if not targetChest or not chestsRoot then return result end
    for _, obj in ipairs(chestsRoot:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == targetChest then
            local hasActivePrompt = false
            for _, prompt in ipairs(obj:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    local collectable = prompt.Parent:FindFirstChild("Collectable")
                    if not collectable or collectable.Value == true then
                        hasActivePrompt = true
                        break
                    end
                end
            end
            if hasActivePrompt then table.insert(result, obj) end
        end
    end
    return result
end

local function triggerPrompt(prompt)
    if not prompt then return end
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0.05)
            prompt:InputHoldEnd()
        end)
    end
end

local function moveTo(pos)
    if not pos or not hrp then return false end
    applyStabilizer(2.0) -- Stabilizer diperpanjang durasinya agar tidak goyang saat mengoleksi

    local distance = (hrp.Position - pos).Magnitude
    local time = math.clamp(distance / tweenSpeed, 0.05, 2.5)
    local success = pcall(function()
        -- Kita teleport sedikit di depan/atas chest agar terhitung masuk ke radius prompt
        local targetCFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) 
        local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end)
    
    task.wait(0.1) -- Jeda mikro setelah bergerak agar posisi tersinkronisasi dengan server
    if success then return true end

    if humanoid and humanoid.Parent then
        local ok = pcall(function()
            humanoid:MoveTo(pos + Vector3.new(0,1.5,0))
            humanoid.MoveToFinished:Wait()
        end)
        return ok
    end
    return false
end

local function markCollected(model)
    recentCollected[model] = tick()
end
local function wasRecentlyCollected(model)
    if not model then return false end
    local t = recentCollected[model]
    if not t then return false end
    return (tick() - t) < recentCooldown
end

-- 🛠️ FIXED: Fungsi ini sekarang memastikan prompt benar-benar hilang/terproses sebelum selesai
local function collectFromChest(chest)
    if not chest or not chest:IsA("Model") then return false end
    if wasRecentlyCollected(chest) then return false end

    local pos = getChestPosition(chest)
    if not pos then return false end

    local moved = moveTo(pos)
    if not moved then return false end

    local prompts = {}
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            local collectable = desc.Parent:FindFirstChild("Collectable")
            if not collectable or collectable.Value == true then
                table.insert(prompts, desc)
            end
        end
    end

    if #prompts == 0 then return false end

    local function runPromptLogic(prompt)
        for i = 1, maxRetryPerPrompt do
            -- Cek ulang apakah prompt masih aktif & valid sebelum klik
            if not prompt or not prompt.Parent or not prompt.Enabled then break end
            
            triggerPrompt(prompt)
            
            -- Waktu tunggu disesuaikan dengan HoldDuration chest ditambah buffer pengaman luar
            local waitTime = (prompt.HoldDuration or 0.05) + retryBuffer
            task.wait(waitTime)
            
            -- Cek apakah objek "Collectable" sudah berubah status (artinya sukses terambil)
            local collectable = prompt.Parent:FindFirstChild("Collectable")
            if not prompt.Enabled or (collectable and collectable.Value == false) or not prompt:IsDescendantOf(workspace) then
                break -- Keluar dari loop retry jika berhasil dicolllect
            end
        end
    end

    if #prompts == 1 then
        runPromptLogic(prompts[1])
    else
        local remaining = #prompts
        local doneEvent = Instance.new("BindableEvent")

        for _, prompt in ipairs(prompts) do
            task.spawn(function()
                runPromptLogic(prompt)
                remaining -= 1
                if remaining <= 0 then
                    doneEvent:Fire()
                end
            end)
        end

        doneEvent.Event:Wait()
        doneEvent:Destroy()
    end

    -- Tambahan jeda akhir opsional agar animasi collect server selesai
    task.wait(0.15) 
    markCollected(chest)
    return true
end

-- Main auto loop
task.spawn(function()
    while true do
        if autoCollect and targetChest and hrp and humanoid and humanoid.Health > 0 then
            if noclipEnabled then enableNoclip() else disableNoclip() end

            local chests = findAllChests()
            if #chests > 0 then
                table.sort(chests, function(a,b)
                    local pa, pb = getChestPosition(a), getChestPosition(b)
                    if not pa then return false end
                    if not pb then return true end
                    return (hrp.Position - pa).Magnitude < (hrp.Position - pb).Magnitude
                end)
                for _, chest in ipairs(chests) do
                    if not autoCollect then break end
                    if not wasRecentlyCollected(chest) then
                        collectFromChest(chest)
                    end
                end
            end
        else
            disableNoclip()
        end
        task.wait(scanInterval)
        scanUniqueChests()
    end
end)

