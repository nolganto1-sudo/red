-- Plant root
local plantsRoot = workspace:FindFirstChild("Plants")

-- helper: safe destroy GUI objects
local function safeDestroyGui(obj)
    if obj and obj.Destroy and type(obj.Destroy) == "function" then
        pcall(function() obj:Destroy() end)
    end
end

-- create button
local function createPlantButton(name)
    if plantButtons[name] and plantButtons[name].Parent then return end
    local btn = Instance.new("TextButton", scrollFrame)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Text = name
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.fromRGB(120,0,0)
    btn.TextColor3 = Color3.fromRGB(255,255,255)

    btn.MouseButton1Click:Connect(function()
        targetPlant = name
        for k, v in pairs(plantButtons) do
            if v and v:IsA("TextButton") then
                v.BackgroundColor3 = (k == name) and Color3.fromRGB(0,150,0) or Color3.fromRGB(120,0,0)
            end
        end
        infoLabel.Text = "Target: "..name
    end)

    plantButtons[name] = btn
end

-- scan plants (unique names with active prompt)
local function scanUniquePlants()
    if scanning then return end
    scanning = true

    -- cleanup old gui buttons that were destroyed or removed
    for name, btn in pairs(plantButtons) do
        if not btn or not btn.Parent then
            plantButtons[name] = nil
        end
    end

    local foundNames = {}
    if plantsRoot then
        for _, child in ipairs(plantsRoot:GetDescendants()) do
            if child:IsA("Model") then
                local hasActivePrompt = false
                for _, prompt in ipairs(child:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        -- check Collectable flag if exists
                        local collectable = prompt.Parent:FindFirstChild("Collectable")
                        if not collectable or collectable.Value == true then
                            hasActivePrompt = true
                            break
                        end
                    end
                end
                if hasActivePrompt then
                    foundNames[child.Name] = true
                end
            end
        end
    end

    -- create/update buttons for found names
    for name,_ in pairs(foundNames) do
        createPlantButton(name)
    end

    -- remove buttons no longer found
    for name, btn in pairs(plantButtons) do
        if not foundNames[name] then
            safeDestroyGui(btn)
            plantButtons[name] = nil
            if targetPlant == name then
                targetPlant = nil
                infoLabel.Text = "Target removed"
            end
        end
    end

    -- update label
    local count = 0
    for _,v in pairs(plantButtons) do if v and v.Parent then count = count + 1 end end
    if count == 0 then
        infoLabel.Text = "Tidak ada plant yang punya item."
    else
        infoLabel.Text = "Found: "..tostring(count)
    end

    scanning = false
end

refreshBtn.MouseButton1Click:Connect(scanUniquePlants)
scanUniquePlants()

-- Noclip helper (safer: only disable collision for character baseparts while auto ON)
local noclipConn = nil
local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    -- only disable on non-Accessory parts that normally collide
                    if part.Name == "HumanoidRootPart" or part.Name == "LowerTorso" or part.Name == "UpperTorso" or part:IsDescendantOf(char) then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end
local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    -- restore CanCollide to true for main parts (best-effort)
    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = true end)
            end
        end
    end
end

-- Stabilizer single instances reused
local currentGyro = nil
local currentBV = nil
local function applyStabilizer(duration)
    duration = duration or 1.2
    if not hrp then return end
    if currentGyro and currentGyro.Parent then currentGyro:Destroy() end
    if currentBV and currentBV.Parent then currentBV:Destroy() end

    currentGyro = Instance.new("BodyGyro")
    currentGyro.P = 4000
    currentGyro.D = 100
    currentGyro.MaxTorque = Vector3.new(4e5,4e5,4e5)
    currentGyro.CFrame = hrp.CFrame
    currentGyro.Parent = hrp

    currentBV = Instance.new("BodyVelocity")
    currentBV.Velocity = Vector3.new(0,0,0)
    currentBV.MaxForce = Vector3.new(1e6,1e6,1e6)
    currentBV.Parent = hrp

    Debris:AddItem(currentGyro, duration)
    Debris:AddItem(currentBV, duration)
end

-- getPlantPosition
local function getPlantPosition(plant)
    if not plant then return nil end
    if plant.PrimaryPart then return plant.PrimaryPart.Position end
    for _, p in ipairs(plant:GetDescendants()) do
        if p:IsA("BasePart") then return p.Position end
    end
    return nil
end

-- findAllPlants for target name with active prompts
local function findAllPlants()
    local result = {}
    if not targetPlant or not plantsRoot then return result end
    for _, obj in ipairs(plantsRoot:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == targetPlant then
            local hasActivePrompt = false
            for _, prompt in ipairs(obj:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    local collectable = prompt.Parent:FindFirstChild("Collectable")
                    if not collectable or collectable.Value == true then
                        hasActivePrompt = true
                        break
                    end
                end
            end
            if hasActivePrompt then table.insert(result, obj) end
        end
    end
    return result
end

-- trigger prompt with fallback (fireproximityprompt if available)
local function triggerPrompt(prompt)
    if not prompt then return end
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0.05)
            prompt:InputHoldEnd()
        end)
    end
end

-- safer moveTo: tween HRP CFrame, fallback to Humanoid:MoveTo
local function moveTo(pos)
    if not pos or not hrp then return false end
    applyStabilizer(1.5)

    local distance = (hrp.Position - pos).Magnitude
    local time = math.clamp(distance / tweenSpeed, 0.04, 2.2)
    local success = pcall(function()
        local targetCFrame = CFrame.new(pos + Vector3.new(0,3,0))
        local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end)
    if success then return true end

    -- fallback: use Humanoid:MoveTo if available
    if humanoid and humanoid.Parent then
        local ok, err = pcall(function()
            humanoid:MoveTo(pos + Vector3.new(0,3,0))
            humanoid.MoveToFinished:Wait()
        end)
        return ok
    end
    return false
end

-- mark recent collected (by model instance)
local function markCollected(model)
    recentCollected[model] = tick()
end
local function wasRecentlyCollected(model)
    if not model then return false end
    local t = recentCollected[model]
    if not t then return false end
    return (tick() - t) < recentCooldown
end

-- collect from single plant (with retry logic)
local function collectFromPlant(plant)
    if not plant or not plant:IsA("Model") then return false end
    if wasRecentlyCollected(plant) then return false end

    local pos = getPlantPosition(plant)
    if not pos then return false end

    local moved = moveTo(pos)
    if not moved then return false end

    -- gather all prompts in plant
    local prompts = {}
    for _, desc in ipairs(plant:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            local collectable = desc.Parent:FindFirstChild("Collectable")
            if not collectable or collectable.Value == true then
                table.insert(prompts, desc)
            end
        end
    end

    if #prompts == 0 then
        return false
    end

    local anyTriggered = false
    for _, prompt in ipairs(prompts) do
        local tries = 0
        while tries < maxRetryPerPrompt do
            tries = tries + 1
            -- start the trigger (non-blocking)
            task.spawn(function() triggerPrompt(prompt) end)
            -- wait for prompt hold duration + buffer
            task.wait((prompt.HoldDuration or 0.05) + retryBuffer)
            -- check if prompt still enabled or collectable flag still true
            local stillActive = false
            if prompt and prompt.Parent and prompt:IsA("ProximityPrompt") then
                if prompt.Enabled then
                    local collectable = prompt.Parent:FindFirstChild("Collectable")
                    if not collectable or collectable.Value == true then
                        stillActive = true
                    end
                end
            end
            if not stillActive then
                anyTriggered = true
                break -- proceed to next prompt
            else
                -- small pause before retry
                task.wait(0.08)
            end
        end
    end

    if anyTriggered then
        markCollected(plant)
        return true
    end

    return false
end

-- Main auto loop
task.spawn(function()
    while true do
        if autoCollect and targetPlant and hrp and humanoid and humanoid.Health > 0 then
            if noclipEnabled then enableNoclip() else disableNoclip() end

            local plants = findAllPlants()
            if #plants > 0 then
                -- sort by distance
                table.sort(plants, function(a,b)
                    local pa, pb = getPlantPosition(a), getPlantPosition(b)
                    if not pa then return false end
                    if not pb then return true end
                    return (hrp.Position - pa).Magnitude < (hrp.Position - pb).Magnitude
                end)
                for _, plant in ipairs(plants) do
                    if not autoCollect then break end
                    -- skip recently collected
                    if wasRecentlyCollected(plant) then
                        -- skip
                    else
                        collectFromPlant(plant)
                    end
                end
            end
        else
            disableNoclip()
        end
        task.wait(scanInterval)
        -- periodic scan to refresh GUI
        scanUniquePlants()
    end
end)

